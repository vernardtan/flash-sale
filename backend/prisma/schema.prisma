// Flash Sale persistence model.
//
// PostgreSQL is the authoritative source of truth for products, inventory,
// flash sales, checkouts, and purchases. Redis is never authoritative.
//
// Conventions:
// - snake_case table/column names via @@map/@map; camelCase in TypeScript.
// - All timestamps are timestamptz and treated as UTC end to end.
// - Money uses Decimal(12,2); never floating point.
// - CHECK constraints (stock bounds, quantity > 0, end_time > start_time)
//   are not expressible in Prisma schema; they are added by hand in the
//   initial migration SQL. Do not regenerate that migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CheckoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  price          Decimal     @db.Decimal(12, 2)
  currency       String      @db.VarChar(3)
  totalStock     Int         @map("total_stock")
  remainingStock Int         @map("remaining_stock")
  isEnabled      Boolean     @map("is_enabled")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  flashSales     FlashSale[]
  checkouts      Checkout[]
  purchases      Purchase[]

  @@map("products")
}

model FlashSale {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  startTime DateTime @map("start_time") @db.Timestamptz(6)
  endTime   DateTime @map("end_time") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Looked up by product when deriving sale status.
  @@index([productId])
  @@map("flash_sales")
}

model Checkout {
  id            String         @id @default(uuid()) @db.Uuid
  requestId     String         @unique @map("request_id")
  userId        String         @map("user_id")
  productId     String         @map("product_id") @db.Uuid
  quantity      Int
  // Price snapshot at checkout time: later product price changes must not
  // alter an existing checkout or order.
  unitPrice     Decimal        @map("unit_price") @db.Decimal(12, 2)
  currency      String         @db.VarChar(3)
  paymentMethod String         @map("payment_method")
  status        CheckoutStatus @default(PENDING)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase      Purchase?

  // Looked up by user when listing/validating a user's checkout, and by
  // product for sales reporting.
  @@index([userId])
  @@index([productId])
  @@map("checkouts")
}

model Purchase {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id")
  productId String @map("product_id") @db.Uuid
  // The checkout this purchase fulfills. Unique: one checkout completes at
  // most once.
  requestId String @unique @map("request_id")
  quantity  Int
  // True when the purchased product is the flash-sale product. A partial
  // unique index enforces one flash-sale purchase per user while allowing
  // regular products to be repurchased.
  isFlashSale   Boolean  @default(false) @map("is_flash_sale")
  // Price snapshot captured from the checkout at purchase time.
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  paymentMethod String   @map("payment_method")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  checkout      Checkout @relation(fields: [requestId], references: [requestId], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@map("purchases")
}
