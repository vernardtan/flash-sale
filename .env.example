# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
# DATABASE_HOST/PORT/NAME/USER/PASSWORD configure the postgres container itself.
# DATABASE_URL is what the backend (Prisma) connects with.
# In Docker Compose it points at the postgres service; for host-local commands
# (prisma migrate, tests) use localhost instead: postgresql://...@localhost:5432/flash_sale
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=flash_sale
DATABASE_USER=flash_sale
DATABASE_PASSWORD=flash_sale_dev
DATABASE_URL=postgresql://flash_sale:flash_sale_dev@postgres:5432/flash_sale

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Flash sale operational kill switch
FLASH_SALE_ENABLED=true

# How long a checkout stays PENDING before it is considered expired
CHECKOUT_EXPIRATION_SECONDS=900

# How long a checkout may remain in PROCESSING before it is treated as stale
# and lazily recovered to FAILED. This prevents stranded PROCESSING states
# after an application crash.
CHECKOUT_PROCESSING_TIMEOUT_SECONDS=300

# Rate limiting (Redis fixed window, per user/IP). Protection only — if Redis
# is down the limiter fails open and PostgreSQL still guarantees correctness.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_TRANSACTION_MAX=20

# Run the idempotent development seed on backend startup (dev convenience)
SEED_ON_STARTUP=true

# Frontend (build-time)
VITE_API_URL=http://localhost:3000
